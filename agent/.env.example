# Required — the agent's LLM provider.
OPENAI_API_KEY=sk-...

# Optional — defaults live in src/factory_agent/config.py.
# OPENAI_MODEL=gpt-5.6-terra
# BACKEND_API_BASE=http://localhost:3000

# Optional — LangSmith tracing. Required only to run the evals
# (uv run python -m factory_agent.evals.run).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=factory-flow-agent
